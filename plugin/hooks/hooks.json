{
  "description": "Inject project memory at session start, capture the session at its end and before compaction, compile captured sessions in the background.",
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/scripts/launch.sh hook context-inject; ${CLAUDE_PLUGIN_ROOT}/scripts/launch.sh hook compile --detach" }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/scripts/launch.sh hook auto-capture --hook-event; ${CLAUDE_PLUGIN_ROOT}/scripts/launch.sh hook compile --detach" }] }
    ],
    "PreCompact": [
      { "hooks": [{ "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/scripts/launch.sh hook checkpoint --hook-event" }] }
    ]
  }
}
